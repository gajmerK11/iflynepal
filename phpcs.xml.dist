				<element value="iflynepal_render_about_promo_description"/>
				<element value="iflynepal_render_about_promo_button"/>
				<element value="iflynepal_render_about_vision_title"/>
				<element value="iflynepal_render_about_vision_content"/>
				<element value="iflynepal_render_about_offer_kicker"/>
				<element value="iflynepal_render_about_offer_title"/>
				<element value="iflynepal_render_about_offer_lead"/>
				<element value="iflynepal_render_about_offers"/>
				<element value="iflynepal_render_country_hero_title"/>
				<element value="iflynepal_render_country_hero_lead"/>
				<element value="iflynepal_render_country_index"/>
				<element value="iflynepal_render_country_chapter_eyebrow"/>
				<element value="iflynepal_render_country_chapter_title"/>
				<element value="iflynepal_render_country_chapter_prose"/>
				<element value="iflynepal_render_country_note_label"/>
				<element value="iflynepal_render_country_note_title"/>
				<element value="iflynepal_render_country_note_text"/>
				<element value="iflynepal_render_country_bands"/>
				<element value="iflynepal_render_country_regions"/>
