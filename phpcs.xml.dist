				<element value="iflynepal_render_about_hero_actions"/>
				<element value="iflynepal_render_about_overview_kicker"/>
				<element value="iflynepal_render_about_overview_title"/>
				<element value="iflynepal_render_about_story"/>
				<element value="iflynepal_render_about_promo_kicker"/>
