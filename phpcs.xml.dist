				<element value="iflynepal_render_privacy_contact_note"/>
				<element value="iflynepal_render_privacy_rights"/>
				<element value="iflynepal_render_sustainability_index"/>
				<element value="iflynepal_render_sustainability_clause_head"/>
				<element value="iflynepal_render_sustainability_pledges"/>
				<element value="iflynepal_render_sustainability_frameworks"/>
				<element value="iflynepal_render_sustainability_policy_link"/>
				<element value="iflynepal_render_sustainability_coordinator"/>
				<element value="iflynepal_article_headline"/>
				<element value="iflynepal_articles_hero_title_html"/>
				<element value="iflynepal_blogs_hero_title_html"/>
				<element value="iflynepal_hero_title_words"/>
				<element value="iflynepal_section_hero_title_html"/>
				<element value="iflynepal_section_match_count"/>
				<element value="iflynepal_render_footer_blurb"/>
				<element value="iflynepal_render_footer_office"/>
				<element value="iflynepal_render_footer_office_heading"/>
				<element value="iflynepal_render_footer_reviews"/>
				<element value="iflynepal_render_footer_socials"/>
				<element value="iflynepal_render_footer_copyright"/>

				<!-- Core builds and escapes this markup itself; it is captured with 'echo' => 0 and printed. -->
				<element value="wp_dropdown_pages"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="iflynepal"/>
				<element value="IFLYNEPAL"/>
				<element value="IFly_Nepal"/>
			</property>
		</properties>
	</rule>
</ruleset>