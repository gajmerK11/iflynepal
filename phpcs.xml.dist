				<element value="iflynepal_render_csr_community_title"/>
				<element value="iflynepal_render_csr_projects"/>
				<element value="iflynepal_render_csr_tourism_kicker"/>
				<element value="iflynepal_render_csr_tourism_title"/>
				<element value="iflynepal_render_csr_tourism_items"/>
