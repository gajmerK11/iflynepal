<?xml version="1.0"?>
<ruleset name="iFly Nepal">
	<description>WordPress coding standards for the iFly Nepal theme.</description>

	<file>.</file>

	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/assets/js/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<rule ref="WordPress">
		<properties>
			<property name="minimum_wp_version" value="6.5"/>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="iflynepal"/>
			</property>
		</properties>
	</rule>

	<!--
		Selective-refresh render callbacks return finished markup: every value
		inside them has already been through esc_html/esc_url/esc_attr or
		iflynepal_kses_text(). Declaring them here rather than repeating an
		ignore comment at each call site, since every section added from now on
		brings another one.
	-->
	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<property name="customAutoEscapedFunctions" type="array">
				<element value="iflynepal_render_hero_title"/>
				<element value="iflynepal_render_hero_actions"/>
				<element value="iflynepal_render_hero_trust_points"/>
				<element value="iflynepal_render_explore_kicker"/>
				<element value="iflynepal_render_explore_title"/>
				<element value="iflynepal_render_explore_card_eyebrow"/>
				<element value="iflynepal_render_explore_card_title"/>
				<element value="iflynepal_render_explore_card_description"/>
				<element value="iflynepal_render_explore_card_links"/>
				<element value="iflynepal_render_trust_kicker"/>
				<element value="iflynepal_render_trust_title"/>
				<element value="iflynepal_render_trust_feature_icon"/>
				<element value="iflynepal_render_trust_feature_title"/>
				<element value="iflynepal_render_trust_feature_description"/>
				<element value="iflynepal_render_trust_promo_kicker"/>
				<element value="iflynepal_render_trust_promo_title"/>
				<element value="iflynepal_render_trust_promo_description"/>
				<element value="iflynepal_render_trust_promo_button"/>
				<element value="iflynepal_render_trust_logos"/>
				<element value="iflynepal_render_people_kicker"/>
				<element value="iflynepal_render_people_title"/>
				<element value="iflynepal_render_people_lead"/>
				<element value="iflynepal_render_people_cta"/>
				<element value="iflynepal_render_people_card_photo"/>
				<element value="iflynepal_render_people_card_title"/>
				<element value="iflynepal_render_people_card_name"/>
				<element value="iflynepal_render_people_card_country"/>
				<element value="iflynepal_render_testimonial_platform_icon"/>
				<element value="iflynepal_render_faq_kicker"/>
				<element value="iflynepal_render_faq_title"/>
				<element value="iflynepal_render_faq_items"/>
				<element value="iflynepal_render_faq_cta"/>
				<element value="iflynepal_render_guide_kicker"/>
				<element value="iflynepal_render_guide_title"/>
				<element value="iflynepal_render_guide_posts"/>
				<element value="iflynepal_render_guide_cta"/>
				<element value="iflynepal_render_cta_kicker"/>
				<element value="iflynepal_render_cta_title"/>
				<element value="iflynepal_render_cta_description"/>
				<element value="iflynepal_render_cta_actions"/>

				<!-- Core builds and escapes this markup itself; it is captured with 'echo' => 0 and printed. -->
				<element value="wp_dropdown_pages"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="iflynepal"/>
				<element value="IFLYNEPAL"/>
				<element value="IFly_Nepal"/>
			</property>
		</properties>
	</rule>
</ruleset>