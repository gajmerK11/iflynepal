				<element value="iflynepal_render_team_reps_title"/>
				<element value="iflynepal_render_team_reps_lead"/>
				<element value="iflynepal_render_team_representatives"/>
				<element value="iflynepal_render_team_executive_title"/>
				<element value="iflynepal_render_team_executive_lead"/>
				<element value="iflynepal_render_team_members"/>
				<element value="iflynepal_render_csr_hero_kicker"/>
				<element value="iflynepal_render_csr_hero_title"/>
				<element value="iflynepal_render_csr_hero_lead"/>
				<element value="iflynepal_render_csr_commitment_kicker"/>
				<element value="iflynepal_render_csr_commitment_title"/>
				<element value="iflynepal_render_csr_commitment_paragraphs"/>
				<element value="iflynepal_render_csr_pledge_kicker"/>
				<element value="iflynepal_render_csr_pledge"/>
