				<element value="iflynepal_render_terms_cta_actions"/>
				<element value="iflynepal_render_terms_cta_lines"/>
				<element value="iflynepal_render_cookie_index"/>
				<element value="iflynepal_render_cookie_clause_head"/>
				<element value="iflynepal_render_cookie_browsers"/>
